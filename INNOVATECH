  <div id="classroomModal" class="modal-overlay">
    <div class="modal-card">
      <button class="modal-close" onclick="closeModal()">&times;</button>
      <h2 id="modalTitle" class="modal-title">Título del Classroom</h2>
      <div id="modalSubtitle" class="modal-subtitle">Subtítulo</div>
      
      <div id="activityTabsHeader" class="activity-tabs-header"></div>
      <div id="activityPanelsContainer"></div>
    </div>
  </div>

  <script>
    function switchTab(gradeId, element) {
      document.querySelectorAll('.grade-content').forEach(el => el.classList.remove('active'));
      document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));
      
      document.getElementById(gradeId).classList.add('active');
      element.classList.add('active');
    }

    function scrollToContent() {
      document.getElementById('main-container').scrollIntoView({ behavior: 'smooth' });
    }

    function filterClassrooms() {
      let query = document.getElementById('searchInput').value.toLowerCase();
      let cards = document.querySelectorAll('.card');
      let gradeTabs = document.getElementById('gradeTabs');

      if(query.trim() !== "") {
        gradeTabs.style.display = 'none';
        document.querySelectorAll('.grade-content').forEach(el => el.classList.add('active'));
      } else {
        gradeTabs.style.display = 'flex';
        document.querySelectorAll('.grade-content').forEach(el => el.classList.remove('active'));
        document.getElementById('g9').classList.add('active');
        document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));
        document.querySelector('.tab-btn').classList.add('active');
      }

      cards.forEach(card => {
        let name = card.getAttribute('data-name');
        let title = card.querySelector('.card-title').innerText.toLowerCase();
        let desc = card.querySelector('.card-desc').innerText.toLowerCase();
        
        if (name.includes(query) || title.includes(query) || desc.includes(query)) {
          card.style.display = "flex";
        } else {
          card.style.display = "none";
        }
      });
    }

    function openClassroomModal(title, subtitle, activities) {
      document.getElementById('modalTitle').innerText = title;
      document.getElementById('modalSubtitle').innerText = subtitle;
      
      const headerContainer = document.getElementById('activityTabsHeader');
      const panelsContainer = document.getElementById('activityPanelsContainer');
      
      headerContainer.innerHTML = "";
      panelsContainer.innerHTML = "";

      activities.forEach((act, index) => {
        let isActive = index === 0 ? 'active' : '';

        let tabBtn = document.createElement('button');
        tabBtn.className = `activity-tab-btn ${isActive}`;
        tabBtn.innerText = `Act. ${index + 1}`;
        tabBtn.title = act.name;
        tabBtn.onclick = (e) => switchActivityTab(`panel-${index}`, e.currentTarget);
        headerContainer.appendChild(tabBtn);

        let videoHTML = act.video ? `
          <div class="video-box">
            <iframe src="${act.video}" allowfullscreen></iframe>
          </div>
        ` : `<p style="font-size:12px; color:#888; font-style:italic; margin-bottom:12px;">No hay video adjunto disponible.</p>`;

        let panelDiv = document.createElement('div');
        panelDiv.className = `activity-panel ${isActive}`;
        panelDiv.id = `panel-${index}`;
        panelDiv.innerHTML = `
          <div class="act-header-info">
            <h4 class="act-name">${act.name}</h4>
          </div>
          <div class="act-date">${act.date}</div>
          <div class="act-description"><strong>Enunciado:</strong> ${act.desc}</div>
          ${videoHTML}
          
          <!-- ZONA DE CARGA DE ARCHIVOS Y LINKS -->
          <div class="submission-area">
            <div class="submission-title">Entregar Trabajo y Recursos</div>
            
            <textarea id="links-${index}" class="link-input" placeholder="Pega aquí enlaces o URLs de apoyo (un enlace por línea o separados por comas)..."></textarea>
            
            <div class="file-box">
              <label class="file-btn" for="file-${index}">Seleccionar Varios Archivos</label>
              <input type="file" id="file-${index}" multiple onchange="handleMultipleFiles(this, 'status-${index}')">
              <div id="status-${index}" class="file-status">Ningún archivo seleccionado</div>
            </div>
            
            <button class="send-btn" onclick="submitActivity('${act.name}', 'file-${index}', 'links-${index}')">Enviar Actividad Completa</button>
          </div>
        `;
        panelsContainer.appendChild(panelDiv);
      });

      document.getElementById('classroomModal').classList.add('active');
    }

    function switchActivityTab(panelId, btnElement) {
      document.querySelectorAll('.activity-panel').forEach(el => el.classList.remove('active'));
      document.querySelectorAll('.activity-tab-btn').forEach(el => el.classList.remove('active'));
      
      document.getElementById(panelId).classList.add('active');
      btnElement.classList.add('active');
    }

    function closeModal() {
      document.getElementById('classroomModal').classList.remove('active');
    }

    function handleMultipleFiles(input, statusId) {
      const statusDisplay = document.getElementById(statusId);
      if(input.files && input.files.length > 0) {
        let fileNames = [];
        for(let i = 0; i < input.files.length; i++) {
          fileNames.push(`• ${input.files[i].name}`);
        }
        statusDisplay.innerHTML = `<strong>${input.files.length} archivo(s) listo(s):</strong><br>` + fileNames.join('<br>');
      } else {
        statusDisplay.innerText = "Ningún archivo seleccionado";
      }
    }

    function submitActivity(activityName, fileInputId, linkInputId) {
      const files = document.getElementById(fileInputId).files;
      const links = document.getElementById(linkInputId).value.trim();

      if (files.length === 0 && links === "") {
        alert("Por favor adjunta al menos un archivo o ingresa un enlace antes de enviar.");
      } else {
        alert(`¡Actividad enviada con éxito para: ${activityName}!\n- Archivos: ${files.length}\n- Enlaces ingresados: ${links !== "" ? "Sí" : "No"}`);
      }
    }
  
    function loadLogo(input) {
      if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = function(e) {
          const img = document.getElementById('heroLogo');
          img.src = e.target.result;
          img.classList.add('visible');
          document.getElementById('logoPlaceholder').classList.add('hidden');
        };
        reader.readAsDataURL(input.files[0]);
      }
    }
  </script>

</body>
